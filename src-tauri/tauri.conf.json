{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "haneoka",
  "mainBinaryName": "haneoka",
  "version": "0.3.0",
  "identifier": "org.haneoka.haneoka",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://haneoka.org https://haneoka.com; img-src 'self' data: https://haneoka.org https://haneoka.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Haneoka",
    "copyright": "Haneoka contributors",
    "category": "Utility",
    "shortDescription": "Haneoka for BanG Dream! Our Notes",
    "longDescription": "The Haneoka website as an app, with save reading from the phone, a USB-connected phone, iPhone backups and files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "android": {
      "minSdkVersion": 24,
      "versionCode": 10000
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "haneoka"
          ],
          "host": "auth"
        },
        {
          "scheme": [
            "haneoka"
          ],
          "host": "saves"
        },
        {
          "scheme": [
            "haneoka"
          ],
          "host": "gacha-history"
        },
        {
          "scheme": [
            "https"
          ],
          "host": "haneoka.org",
          "appLink": true,
          "pathPrefix": [
            "/jp/",
            "/intl/"
          ]
        },
        {
          "scheme": [
            "https"
          ],
          "host": "haneoka.com",
          "appLink": true,
          "pathPrefix": [
            "/jp/",
            "/intl/"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "haneoka"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1NTdBRUM5RURBREVCRjkKUldUNTY2M3R5YTVYUldDelVqa0JzSXR2UzZ0WmJENkhHMlJCOXp0d0tRaC9JRndxbmlwOTR3bjAK",
      "endpoints": [
        "https://haneoka.org/downloads/app/latest/updater.json",
        "https://github.com/haneoka-gakuen/haneoka-app/releases/latest/download/updater.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
